---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions fréquentes' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq-wrap">
    <h2>{title}</h2>
    <div class="faq">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>
)}

---
import Picture from './Picture.astro';
import { euro, TAG_LABELS, type Listing } from '../lib/listings';
interface Props { l: Listing; eager?: boolean }
const { l, eager = false } = Astro.props;
const tags = l.tags.filter((t) => TAG_LABELS[t]).slice(0, 3);
---
<a
  href={`/locations/${l.slug}/`}
  class="card"
  data-listing
  data-village={l.village}
  data-kind={l.kind}
  data-cap={l.capacity}
  data-tags={l.tags.join('|')}
  data-price={l.priceFrom ?? ''}
>
  <div class="card-media">
    <Picture photo={l.photos[0]} alt={`${l.name} à ${l.village}`} eager={eager} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
    <span class="card-badge">{l.kind === 'chalet' ? 'Chalet' : 'Appartement'}</span>
    {l.skiInSkiOut && <span class="card-badge card-badge--accent">Skis aux pieds</span>}
  </div>
  <div class="card-body">
    <h3 class="card-title">{l.name}</h3>
    <div class="card-meta">{l.village} · {l.capacity} pers.{l.surface ? ` · ${l.surface} m²` : ''}</div>
    {tags.length > 0 && <div class="card-tags">{tags.map((t) => <span class="tag">{TAG_LABELS[t]}</span>)}</div>}
    <div class="card-price">
      {l.priceFrom ? <><span>À partir de</span><strong>{euro(l.priceFrom)}<span> / sem.</span></strong></> : <span>Tarifs sur demande</span>}
    </div>
  </div>
</a>
